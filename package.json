{
  "name": "doom-and-deliverables",
  "private": true,
  "version": "1.0.0",
  "description": "Atticor Media traffic coordination platform",
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o tailwind.css --minify",
    "build:library": "vite build --config vite.library.config.mjs && cp build-library/library-ui.js build-library/library-ui.css .",
    "build": "npm run build:css && npm run build:library",
    "build:watch": "tailwindcss -i src/tailwind.css -o tailwind.css --watch"
  },
  "dependencies": {
    "lucide-react": "0.522.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "framer-motion": "^11.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.4",
    "vite": "^5.2.0"
  }
}
