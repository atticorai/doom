rules_version = '2';

// Storage lockdown: reads stay open (creative files, OOH photos, traffic PDFs
// are linked from emails to vendors and embedded in the portal). Writes
// require an authenticated session — same model as firestore.rules.
//
// Deploy: firebase deploy --only storage
// Revert: copy storage.rules.previous over storage.rules and redeploy.
//         (No previous file shipped — Firebase's default Storage rules were
//         in effect, which are usually the auth-required default. If you've
//         loosened them in the Console, capture the current rules text into
//         storage.rules.previous BEFORE deploying these.)

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
